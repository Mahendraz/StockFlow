# Copy to .env and adjust. Every value here is a safe local placeholder.

# MongoDB connection string. Must point at a replica set (transactions).
# Matches the docker-compose.yml service.
MONGODB_URI=mongodb://localhost:27017/stockflow?replicaSet=rs0&directConnection=true

# Tax rate applied to the invoice subtotal, as a decimal fraction (max 4 decimal places).
TAX_RATE=0.11

# How long a login session stays valid, in hours.
SESSION_TTL_HOURS=12
